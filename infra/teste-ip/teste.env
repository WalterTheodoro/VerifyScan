# Variáveis do teste da cadeia de IP (infra/teste-ip/compose.teste.yml). Valores públicos de
# propósito, como os do CI: não protegem nada fora da rede do compose de teste, que não publica
# porta nenhuma. Em produção, este arquivo é escrito pelo deploy a partir do cofre (ADR-0029).

TAG=teste-ip
DOMINIO=teste.invalid
EMAIL_ACME=teste@exemplo.invalid

POSTGRES_PASSWORD=senha_publica_do_teste_nao_e_segredo
IP_HMAC_SEGREDO=segredo-publico-do-teste-nao-e-segredo-0123456789
PROXY_SEGREDO=segredo-publico-do-teste-nao-e-segredo-9876543210
# A IA fica desligada no teste; a variável só existe porque o compose de produção a exige.
ANTHROPIC_API_KEY=nao-usada-no-teste

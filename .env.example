# VerifyScan — variáveis de ambiente
#
# Copie para .env e preencha. O .env NUNCA é versionado (invariante 7 do CLAUDE.md).
#   Copy-Item .env.example .env
#
# As variáveis estão agrupadas pela fase do plano de execução em que passam a ser usadas.
# As da Fase 0 já são lidas pelo backend; as demais estão declaradas aqui para que ninguém
# descubra na Fase 7 que falta uma chave.

# ─────────────────────────────────────────────────────────────────────────────
# Fase 0 — aplicação
# ─────────────────────────────────────────────────────────────────────────────

# Ambiente lógico da aplicação: local | ci | producao
APP_ENV=local

# Nível de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Origens autorizadas no CORS, separadas por vírgula (onde o frontend roda)
CORS_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Fase 0 — PostgreSQL
# ─────────────────────────────────────────────────────────────────────────────

# Credenciais consumidas pelo docker-compose.yml ao criar o container
POSTGRES_USER=verifyscan
POSTGRES_PASSWORD=
POSTGRES_DB=verifyscan
POSTGRES_PORT=5432

# URL usada pelo SQLAlchemy e pelo Alembic.
# O driver é psycopg3 e o dialeto é async (ADR-0001) — não trocar por asyncpg nem por psycopg2.
DATABASE_URL=postgresql+psycopg://verifyscan:SENHA_AQUI@localhost:5432/verifyscan

# ─────────────────────────────────────────────────────────────────────────────
# Fase 0 — Redis
# ─────────────────────────────────────────────────────────────────────────────

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# Fase 0 — orçamento de tempo do pipeline (ADR-0002)
# ─────────────────────────────────────────────────────────────────────────────
# Todo I/O externo tem timeout explícito. Nenhum cliente HTTP roda com o default da biblioteca.

# Checagem de saúde de Postgres e Redis em GET /health
TIMEOUT_HEALTH_S=2

# OCR, em série antes de tudo (Fase 5)
TIMEOUT_OCR_S=5

# Heurísticas locais de texto, URL e e-mail (Fases 1, 3 e 6)
TIMEOUT_HEURISTICAS_MS=300

# RDAP para idade de domínio (Fase 3)
TIMEOUT_RDAP_S=3

# Reputação externa: VirusTotal e Safe Browsing (Fase 4)
TIMEOUT_REPUTACAO_S=5

# LLM do AIFormulator (Fase 7)
TIMEOUT_LLM_S=5

# ─────────────────────────────────────────────────────────────────────────────
# Fase 4 — reputação externa e cache
# ─────────────────────────────────────────────────────────────────────────────

# TTL do cache de reputação por URL canonicalizada, em segundos (24h)
CACHE_TTL_SEGUNDOS=86400

# https://www.virustotal.com/gui/my-apikey — cota gratuita: 4 req/min, 500/dia
VIRUSTOTAL_API_KEY=

# Rate limiter local que respeita a cota acima. Não aumentar sem trocar de plano.
VT_RATE_LIMIT_POR_MINUTO=4

# https://console.cloud.google.com — habilitar a Safe Browsing API no projeto
GOOGLE_SAFE_BROWSING_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Fase 5 — OCR
# ─────────────────────────────────────────────────────────────────────────────

# Caminho do binário do Tesseract. No Windows o pytesseract não acha sozinho.
# Instalação padrão do build do UB Mannheim:
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Idioma do OCR. Exige o pacote 'por' marcado durante a instalação.
TESSERACT_LANG=por

# Tamanho máximo aceito no upload de imagem, em megabytes
UPLOAD_MAX_MB=10

# ─────────────────────────────────────────────────────────────────────────────
# Fase 7 — AIFormulator
# ─────────────────────────────────────────────────────────────────────────────

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

ANTHROPIC_MODEL=claude-haiku-4-5

# Temperatura baixa: a LLM redige, não decide risco (RF13)
ANTHROPIC_TEMPERATURE=0.3

ANTHROPIC_MAX_TOKENS=512

# ─────────────────────────────────────────────────────────────────────────────
# Fase 8 — autenticação, histórico e LGPD
# ─────────────────────────────────────────────────────────────────────────────

# Segredo de assinatura do JWT. Gerar um valor aleatório por ambiente:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

JWT_ALGORITHM=HS256

# Expiração do token de acesso, em minutos
JWT_EXPIRACAO_MINUTOS=60

# Análises por minuto por IP, para usuário anônimo
RATE_LIMIT_ANONIMO_POR_MINUTO=5

# Análises por minuto por usuário autenticado
RATE_LIMIT_AUTENTICADO_POR_MINUTO=30

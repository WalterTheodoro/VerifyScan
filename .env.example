# VerifyScan — variáveis de ambiente
#
# Copie para .env e preencha. O .env NUNCA é versionado (invariante 7 do CLAUDE.md).
#   Copy-Item .env.example .env
#
# As variáveis estão agrupadas pela fase do plano de execução em que passam a ser usadas.
# As da Fase 0 já são lidas pelo backend; as demais estão declaradas aqui para que ninguém
# descubra na Fase 7 que falta uma chave.

# ─────────────────────────────────────────────────────────────────────────────
# Fase 0 — aplicação
# ─────────────────────────────────────────────────────────────────────────────

# Ambiente lógico da aplicação: local | ci | producao
APP_ENV=local

# Nível de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Origens autorizadas no CORS, separadas por vírgula (onde o frontend roda)
CORS_ORIGINS=http://localhost:3000

# Teto da mensagem enviada para análise. Acima disso a análise é RECUSADA com mensagem
# informativa — nunca truncada, que devolveria risco calculado sobre conteúdo parcial.
TEXTO_MAX_CARACTERES=5000

# ─────────────────────────────────────────────────────────────────────────────
# Fase 0 — PostgreSQL
# ─────────────────────────────────────────────────────────────────────────────

# Credenciais consumidas pelo docker-compose.yml ao criar o container
POSTGRES_USER=verifyscan
POSTGRES_PASSWORD=
POSTGRES_DB=verifyscan
POSTGRES_PORT=5432

# URL usada pelo SQLAlchemy e pelo Alembic — uma só para os dois.
# O driver é psycopg3 e o dialeto é async (ADR-0001) — não trocar por asyncpg nem por psycopg2.
# Em produção: a string DIRETA do Neon (host sem "-pooler"), colada como vem, com
# ?sslmode=require&channel_binding=require. A app troca postgresql:// / postgres:// por
# postgresql+psycopg:// sozinha (ADR-0011).
DATABASE_URL=postgresql+psycopg://verifyscan:SENHA_AQUI@localhost:5432/verifyscan

# Banco dos testes marcados `integracao`. Ausente: esses testes são pulados.
# O nome do banco PRECISA terminar em _teste — a sessão de testes apaga e recria o esquema.
# Nunca apontar para o Neon (os testes recusam). Criar uma vez:
#   docker compose exec postgres createdb -U verifyscan verifyscan_teste
TEST_DATABASE_URL=postgresql+psycopg://verifyscan:SENHA_AQUI@localhost:5432/verifyscan_teste

# ─────────────────────────────────────────────────────────────────────────────
# Fase 0 — Redis
# ─────────────────────────────────────────────────────────────────────────────

REDIS_PORT=6379

# Ausente ou vazia: Redis DESATIVADO — o /health responde "desativado" e continua 200. É o estado
# de produção até a Fase 4 (no Render, deixar sem valor). Local, aponta para o docker compose.
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# Fase 0 — orçamento de tempo do pipeline (ADR-0002)
# ─────────────────────────────────────────────────────────────────────────────
# Todo I/O externo tem timeout explícito. Nenhum cliente HTTP roda com o default da biblioteca.

# Checagem de saúde de Postgres e Redis em GET /health
TIMEOUT_HEALTH_S=2

# Registro da análise no banco (Fase 8). Estourar não derruba a análise: a transação é
# descartada, vira WARNING no log e a resposta sai igual (ADR-0012).
TIMEOUT_PERSISTENCIA_S=2

# I/O de banco da autenticação: consultas e commit, nunca o hash da senha. Estourar devolve 503
# "O serviço está iniciando" ao usuário. Separado do de cima porque falham de jeitos opostos;
# 5 s cobre o Neon retomando o compute com folga (ADR-0013).
TIMEOUT_AUTENTICACAO_S=5

# OCR, em série antes de tudo (Fase 5)
TIMEOUT_OCR_S=5

# Heurísticas locais de texto, URL e e-mail (Fases 1, 3 e 6)
TIMEOUT_HEURISTICAS_MS=300

# RDAP para idade de domínio (Fase 3)
TIMEOUT_RDAP_S=3

# Reputação externa: VirusTotal e Safe Browsing (Fase 4)
TIMEOUT_REPUTACAO_S=5

# O teto da análise com IA é IA_TIMEOUT_S, no bloco da Fase 7 (ADR-0020)

# ─────────────────────────────────────────────────────────────────────────────
# Fase 4 — reputação externa e cache
# ─────────────────────────────────────────────────────────────────────────────

# TTL do cache de reputação por URL canonicalizada, em segundos (24h)
CACHE_TTL_SEGUNDOS=86400

# https://www.virustotal.com/gui/my-apikey — cota gratuita: 4 req/min, 500/dia
VIRUSTOTAL_API_KEY=

# Rate limiter local que respeita a cota acima. Não aumentar sem trocar de plano.
VT_RATE_LIMIT_POR_MINUTO=4

# https://console.cloud.google.com — habilitar a Safe Browsing API no projeto
GOOGLE_SAFE_BROWSING_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Fase 5 — print da conversa (ADR-0023; substitui o OCR com Tesseract)
# ─────────────────────────────────────────────────────────────────────────────
# Quem lê o print é o Claude (IA_MODELO, abaixo): com IA_ATIVADA=false, a análise de print
# responde 503 e a de texto segue normal.

# Teto da imagem recebida, em bytes. Máximo 7500000: o limite da Anthropic é 10 MB em base64.
IMAGEM_MAX_BYTES=5242880

# Teto da leitura do print, em segundos, sem nova tentativa. Máximo 10 (invariante 8).
IA_TIMEOUT_LEITURA_S=10

# Teto da análise da IA no caminho de imagem. Máximo 10: com a leitura, o pior caso do desenho
# completo fica em ≈ 27 s (RNF02 < 30 s).
IA_TIMEOUT_ANALISE_IMAGEM_S=10

# Teto da resposta da leitura, em tokens: a transcrição pode ter alguns milhares de caracteres.
IA_MAX_TOKENS_LEITURA=2500

# ─────────────────────────────────────────────────────────────────────────────
# Fase 7 — análise com o Claude (ADR-0020)
# ─────────────────────────────────────────────────────────────────────────────

# Liga a chamada ao Claude depois do motor. Desligada, a resposta é só a do motor (plano B).
# O CI e os testes rodam sempre com false.
IA_ATIVADA=false

# https://console.anthropic.com/settings/keys — obrigatória com IA_ATIVADA=true (o boot falha
# sem ela). Nunca versione o valor.
ANTHROPIC_API_KEY=

IA_MODELO=claude-haiku-5-5

# Teto da chamada, em segundos, sem nova tentativa. Máximo 15 (invariante 8).
IA_TIMEOUT_S=15

# Teto da resposta, em tokens. O Haiku 5.5 não aceita temperature: não há variável para ela.
IA_MAX_TOKENS=700

# ─────────────────────────────────────────────────────────────────────────────
# Fase 8 — autenticação, histórico e LGPD
# ─────────────────────────────────────────────────────────────────────────────

# Validade absoluta da sessão, em dias — também o Max-Age do cookie (ADR-0013)
SESSAO_DIAS=7

# Atributo Secure do cookie de sessão. O default, sem a variável, é true: é o de produção, e no
# Render não precisa ser definida. Local fica false porque localhost é HTTP.
COOKIE_SECURE=false

# Por quantos dias a análise feita logado fica ligada à conta e aparece no histórico. Depois
# disso ela é desvinculada e fica idêntica a uma análise anônima (ADR-0015).
HISTORICO_DIAS=7

# ─────────────────────────────────────────────────────────────────────────────
# Fatia 10 — limites de uso da IA, teto de gasto e proteção do login (ADR-0024)
# ─────────────────────────────────────────────────────────────────────────────

# OBRIGATÓRIAS, sem default: o processo (e o `alembic upgrade`) não sobe sem elas. No mínimo 32
# caracteres. Gere cada uma com:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# IP_HMAC_SEGREDO: chave do HMAC do IP de quem não tem conta. É o que fica no banco no lugar do
# IP. Gere uma vez e não troque: trocar zera as cotas do dia.
IP_HMAC_SEGREDO=
# PROXY_SEGREDO: o MESMO valor no backend e no frontend (frontend/.env.local). Com ele, o backend
# confia no IP do visitante que o proxy do Next repassa; sem ele, ignora o cabeçalho.
PROXY_SEGREDO=

# Cota diária de IA, em unidades (texto 1, print 3), virando à meia-noite de São Paulo. Pode
# subir num evento em que todo mundo sai pelo mesmo IP (até 200 e 500).
IA_COTA_SEM_CONTA=5
IA_COTA_COM_CONTA=25

# Teto de gasto com a IA por dia, somando todo mundo, em US$ (até 20). Atingido, todos ficam sem
# IA até a meia-noite. Calculado pelos tokens que a API devolveu e por estes preços (por milhão).
IA_TETO_GASTO_DIARIO_USD=1.00
IA_PRECO_ENTRADA_USD_POR_MILHAO=0.10
IA_PRECO_SAIDA_USD_POR_MILHAO=0.50

# Janela da cota (sessão + reserva), em segundos, antes da IA. Acima de ~2,8 s o pior caso do
# print passa dos 30 s (invariante 8).
TIMEOUT_COTA_S=1.5

# Senhas erradas por conta e por IP numa janela, em memória (só podem baixar).
LOGIN_FALHAS_POR_CONTA=10
LOGIN_FALHAS_POR_IP=30
LOGIN_JANELA_MINUTOS=15
# Contas novas por IP por dia.
CADASTROS_POR_IP_POR_DIA=5
# Hashes Argon2id ao mesmo tempo no processo (~19 MiB cada).
ARGON2_SIMULTANEOS=2

# Rate limit por minuto — fatia futura. Ainda não lidas pelo backend: a fatia 10 limitou por dia
# (cota da IA), não por minuto.

# Análises por minuto por IP, para usuário anônimo
RATE_LIMIT_ANONIMO_POR_MINUTO=5

# Análises por minuto por usuário autenticado
RATE_LIMIT_AUTENTICADO_POR_MINUTO=30

# ─────────────────────────────────────────────────────────────────────────────
# Fatia 12 — observabilidade (ADR-0026, docs/observabilidade.md)
# ─────────────────────────────────────────────────────────────────────────────

# Formato dos logs: json (uma linha por log, o padrão) | texto (legível, para o terminal local).
# O nível é o LOG_LEVEL, lá em cima.
LOG_FORMAT=texto

# Token de GET /metrics, no cabeçalho "Authorization: Bearer <token>". Mínimo de 32 caracteres.
# Vazio: a rota responde 404, como se não existisse. Gere um com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
METRICS_TOKEN=

# Rastreamento de erros do BACKEND. Vazio: o Sentry nem é inicializado (o estado dos testes e do
# CI). O valor vem do painel do Sentry (Settings → Projects → Client Keys); o de baixo é falso.
# SENTRY_DSN=https://chavepublica@o000000.ingest.us.sentry.io/0000000
SENTRY_DSN=
# Nome do ambiente que aparece em cada erro. Vazio: usa o APP_ENV.
SENTRY_ENVIRONMENT=
# Fração das requisições que viram transação de desempenho, de 0 a 1.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Versão que aparece em cada erro. Vazio: usa o RENDER_GIT_COMMIT, que o Render define sozinho;
# sem nenhum dos dois, o erro sai sem versão.
APP_VERSION=

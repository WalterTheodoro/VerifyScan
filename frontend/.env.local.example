# Copie para .env.local:
#   Copy-Item .env.local.example .env.local
#
# URL do backend, para onde o Next repassa /api/* e /health (ADR-0014). Variável de servidor,
# sem NEXT_PUBLIC_: o navegador chama só caminhos relativos. É lida no build — mudou, rode o
# build de novo. Obrigatória em build de produção; fora dele, o default é http://localhost:8000.
API_URL_INTERNA=http://localhost:8000

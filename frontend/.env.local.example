# Copie para .env.local:
#   Copy-Item .env.local.example .env.local
#
# URL do backend, para onde o Next repassa /api/* e /health (ADR-0014). Variável de servidor,
# sem NEXT_PUBLIC_: o navegador chama só caminhos relativos. É lida no build — mudou, rode o
# build de novo. Obrigatória em build de produção; fora dele, o default é http://localhost:8000.
API_URL_INTERNA=http://localhost:8000

# Endereço público do backend, para o navegador acordá-lo com um GET direto a /health (adendo do
# ADR-0017): no Render gratuito, o pedido que chega pelo proxy recebe 502 e não acorda o backend.
# Localmente não precisa: o proxy alcança o backend sem passar pelo Render. Sem ela, o despertar
# simplesmente não acontece. Também é lida no build.
# NEXT_PUBLIC_URL_DESPERTAR=https://verifyscan.onrender.com
